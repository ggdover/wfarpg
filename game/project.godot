; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wfarpg"
config/description="Play demo: a small part of Storskogen in Act 1, with dense forest and an open meadow."
run/main_scene="res://scenes/start.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/directional_shadow/size=2048
limits/global_shader_variables/buffer_size=524288

[importer_defaults]

scene={
"animation/import": false,
"meshes/ensure_tangents": false,
"meshes/generate_lods": false,
"meshes/light_baking": 0
}
texture={
"compress/mode": 2,
"mipmaps/generate": true,
"process/fix_alpha_border": false
}

[shader_globals]

hero_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
main_camera_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
hero_fade_on={
"type": "float",
"value": 0.0
}
tree_fade_radius={
"type": "float",
"value": 0.0
}
pebble_colour={
"type": "vec3",
"value": Vector3(0.63, 0.40, 0.15)
}
mood_grade={
"type": "vec2",
"value": Vector2(1, 1)
}
